{
  "name": "opinion",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack polling platform",
  "scripts": {
    "dev:shared": "pnpm --filter @opinion/shared dev",
    "dev:api": "pnpm --filter @opinion/api dev",
    "dev:web": "pnpm --filter @opinion/web dev",
    "dev": "pnpm run build:shared && pnpm run --parallel dev:shared dev:api dev:web",
    "build:api": "pnpm --filter @opinion/api build",
    "build:web": "pnpm --filter @opinion/web build",
    "build:shared": "pnpm --filter @opinion/shared build",
    "build": "pnpm run build:shared && pnpm run build:api && pnpm run build:web",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings 0",
    "typecheck": "pnpm --filter @opinion/shared typecheck && pnpm --filter @opinion/api typecheck && pnpm --filter @opinion/web typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.6",
    "eslint": "^9.39.4",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^64.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.3"
  }
}
